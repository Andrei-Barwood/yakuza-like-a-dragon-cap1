<style>
  .grid {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 25px;
  }
  @media (max-width: 800px) {
    .grid { grid-template-columns: 1fr; }
  }
  .card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 8px;
    padding: 20px;
    margin-bottom: 20px;
  }
  .episode-list {
    list-style: none;
  }
  .episode-item {
    margin-bottom: 8px;
  }
  .episode-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 14px;
    background: #141720;
    border: 1px solid var(--card-border);
    border-radius: 6px;
    color: var(--text-main);
    text-decoration: none;
    transition: all 0.2s;
  }
  .episode-link:hover, .episode-link.active {
    border-color: var(--crimson);
    background: #25161a;
  }
  .episode-link.active {
    font-weight: bold;
    border-left: 4px solid var(--crimson);
  }
  .doc-pills {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 15px;
  }
  .doc-pill {
    background: #202533;
    color: var(--text-muted);
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 0.85rem;
    text-decoration: none;
    border: 1px solid #303749;
  }
  .doc-pill:hover {
    background: #2b3347;
    color: #fff;
  }
  .state-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
  }
  .state-table th, .state-table td {
    padding: 8px 12px;
    text-align: left;
    border-bottom: 1px solid var(--card-border);
  }
  .state-table th { color: var(--text-muted); font-weight: normal; }
  .event-timeline {
    list-style: none;
    margin-top: 15px;
  }
  .event-entry {
    padding: 10px 14px;
    background: #12151e;
    border-left: 3px solid var(--gold);
    border-radius: 0 4px 4px 0;
    margin-bottom: 8px;
    font-family: monospace;
    font-size: 0.9rem;
  }
</style>

<div class="grid">
  <!-- Columna izquierda: Catálogo de Episodios -->
  <div>
    <div class="card">
      <h3 style="margin-bottom: 12px; color: var(--gold);">Capítulo 1: Light & Shadow</h3>
      <ul class="episode-list" style="margin-bottom: 20px;">
        <% @episodes.select { |e| e.chapter == 1 }.each do |ep| %>
          <li class="episode-item">
            <a href="/?ep=<%= ep.id %>" class="episode-link <%= 'active' if ep.id == @selected_id %>">
              <div>
                <strong><%= ep.id %></strong>. <%= h(ep.title) %>
              </div>
              <span class="badge badge-gold"><%= ep.slug %></span>
            </a>
          </li>
        <% end %>
      </ul>

      <h3 style="margin-bottom: 12px; color: #ff8a80;">Capítulo 2: Bloody Reunion</h3>
      <ul class="episode-list" style="margin-bottom: 20px;">
        <% @episodes.select { |e| e.chapter == 2 }.each do |ep| %>
          <li class="episode-item">
            <a href="/?ep=<%= ep.id %>" class="episode-link <%= 'active' if ep.id == @selected_id %>">
              <div>
                <strong><%= ep.id %></strong>. <%= h(ep.title) %>
              </div>
              <span class="badge badge-red"><%= ep.slug %></span>
            </a>
          </li>
        <% end %>
      </ul>

      <h3 style="margin-bottom: 12px; color: #80d8ff;">Capítulo 3: The Town at Rock Bottom</h3>
      <ul class="episode-list" style="margin-bottom: 20px;">
        <% @episodes.select { |e| e.chapter == 3 }.each do |ep| %>
