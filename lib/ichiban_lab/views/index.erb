                <strong><%= ep.id %></strong>. <%= h(ep.title) %>
              </div>
              <span class="badge badge-gold"><%= ep.slug %></span>
            </a>
          </li>
        <% end %>
      </ul>

      <h3 style="margin-bottom: 12px; color: #b388ff;">Capítulo 4: The Dragon of Yokohama</h3>
      <ul class="episode-list" style="margin-bottom: 20px;">
        <% @episodes.select { |e| e.chapter == 4 }.each do |ep| %>
